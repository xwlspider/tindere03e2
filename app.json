{
 "expo": {
    "name": "tindere03e2",
    "slug": "tindere03e2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/YutaIcoon.png",
    "scheme": "tindere03e2",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.appphotos"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/YutaIcoon.png"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.anonymous.appphotos"

    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/YutaIcoon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/YutaIcoon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a la app acceder a tu cámara para tomar fotos"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite a la app acceder a tus fotos",
          "savePhotosPermission": "Permite a la app guardar fotos en tu galería",
          "isAccessMediaLocationEnabled": true,
          "androidPermissions": [
          "READ_MEDIA_IMAGES"
        ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
